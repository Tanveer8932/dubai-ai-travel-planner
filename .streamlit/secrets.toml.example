# Streamlit Community Cloud: paste these lines into the app's "Secrets" box
# (App settings -> Secrets). Never commit a real secrets.toml (it is git-ignored).
# Top-level values are exported as environment variables for config.Settings.

# Offline demo (no key, deterministic mock model):
LLM_PROVIDER = "mock"

# Or a real free-tier model (Groq):
# LLM_PROVIDER = "groq"
# GROQ_API_KEY = "<your Groq key>"

# Recommended on hosted runtimes: use curated seed data instead of live public APIs,
# and a descriptive User-Agent with a real contact if you turn live data on.
HTTP_OFFLINE = "true"

# Each browser tab sees only its own sessions and runs (the default; keep it on any
# shared deployment). Never use "shared" on a public app.
SESSION_SCOPE = "visitor"
# HTTP_USER_AGENT = "dubai-ai-travel-planner/0.1 (academic project; contact: you@your-university.edu)"
