# Copy to .env and fill in only what you need. Never commit .env.

# --- LLM provider: ollama | groq | gemini | openai | anthropic | mock ---
LLM_PROVIDER=ollama
# Empty = provider default (ollama: qwen2.5:7b, groq: openai/gpt-oss-20b,
# gemini: gemini-2.5-flash, openai: gpt-4o-mini, anthropic: claude-haiku-5-5).
# Switching LLM_PROVIDER needs no code change; set LLM_MODEL only to override.
LLM_MODEL=
LLM_TEMPERATURE=0.2
# Empty = provider default endpoint (ollama: http://localhost:11434)
LLM_BASE_URL=
# Per-request timeout (s), SDK transport retries (bounded), and schema-repair retries
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_REPAIR_ATTEMPTS=1
# Max output tokens per call. Empty = provider default (groq: 4096, because Groq's own
# 2048 truncates reasoning models like gpt-oss; Groq counts this cap against its
# per-minute token limit, so keep it well under the free tier's 8000 TPM).
LLM_MAX_TOKENS=
# Reasoning effort for reasoning models: low | medium | high. Empty = provider default,
# except Groq openai/gpt-oss-* models, which get "low" (enough for structured output).
LLM_REASONING_EFFORT=
# Optional per-agent model override: LLM_MODEL__<AGENT>, e.g.
# LLM_MODEL__REQUIREMENTS=qwen2.5:3b
# The evaluation judge (scripts/run_eval.py --judge) is agent "judge"; use a different
# model from the generator where possible, e.g. LLM_MODEL__JUDGE=openai/gpt-oss-120b

# Optional keys (leave empty unless using that provider)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Storage ---
DB_PATH=data/app.db
CHECKPOINT_DB_PATH=data/checkpoints.db
CACHE_DIR=data/cache
CACHE_TTL_HOURS=24
SEED_DIR=data/seed

# --- External data ---
# Required by OSM (Nominatim/Overpass) and Wikimedia policies: a descriptive User-Agent
# with a REAL contact email/URL. Wikivoyage returns 403 without contact info and Overpass
# returns 406 for the example.com placeholder (clients then fall back to seed data).
HTTP_USER_AGENT=dubai-ai-travel-planner/0.1 (academic project; contact: you@example.com)
HTTP_TIMEOUT_S=20
# true = never touch the network; use cache, then curated seed fallbacks
HTTP_OFFLINE=false

# --- Planner behaviour ---
MAX_REVIEW_ITERATIONS=2
BUDGET_TOLERANCE=0.05

# --- Streamlit sessions ---
# visitor (default, required for any shared/public deployment): each browser tab sees
# only the sessions it created (refresh = new visitor). shared: single-user local mode,
# every session visible and reopened from ?session=<id> after a refresh.
SESSION_SCOPE=

# --- CrewAI mode ---
# sequential (default; research tasks run concurrently) | hierarchical (a Trip Manager
# agent delegates every task; more LLM calls)
CREWAI_PROCESS=sequential
# max reasoning steps (LLM calls) per CrewAI agent per task attempt
CREWAI_AGENT_MAX_ITER=4

# --- CrewAI / OpenTelemetry telemetry off ---
CREWAI_DISABLE_TELEMETRY=true
# CrewAI execution-trace upload; false also skips its 20 s "view traces?" console prompt
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true

# --- Logging: DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO

# --- Deployment (optional) ---
# Repository root holding data/seed and eval/. Empty = the source checkout, or the
# working directory when the package is installed non-editable (hosted deployments).
DUBAI_PLANNER_ROOT=
